{
  "default": "codex",
  "fallback_order": ["codex", "opus"],
  "timeout_seconds": 300,
  "advisors": {
    "codex": {
      "type": "cli",
      "bin": "codex",
      "args": ["exec", "--sandbox", "read-only", "--skip-git-repo-check", "-"],
      "input": "stdin",
      "label": "OpenAI Codex"
    },
    "grok": {
      "type": "cli",
      "bin": "grok",
      "args": ["-p", "{PROMPT}"],
      "input": "arg",
      "label": "xAI Grok",
      "install_hint": "grok CLI が未導入です。導入後は config.json の args をそのまま使えるはずですが、実際の CLI 仕様に合わせて調整してください。"
    },
    "opus": {
      "type": "claude-agent",
      "model": "opus",
      "label": "Claude Opus"
    },
    "fable": {
      "type": "claude-agent",
      "model": "fable",
      "label": "Claude Fable"
    }
  }
}
